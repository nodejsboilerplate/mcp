{
  "name": "mcp",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "server:inspect": "set DANGEROUSLY_OMIT_AUTH=true && npx @modelcontextprotocol/inspector http://127.0.0.1:3000/mcp",
    "format": "prettier --write \"**/*.{ts,md,json}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --verbose",
    "db:push": "drizzle-kit push",
    "test": "echo \"Error: no test specified\" && exit 1",
    "check:types": "node ./node_modules/typescript-7/bin/tsc --noEmit",
    "prepare": "husky",
    "commit": "cz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodejsboilerplate/mcp.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/nodejsboilerplate/mcp/issues"
  },
  "homepage": "https://github.com/nodejsboilerplate/mcp#readme",
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "dependencies": {
    "@langchain/core": "^1.2.10",
    "@langchain/mongodb": "^1.3.0",
    "@langchain/textsplitters": "^1.0.1",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "husky": "^9.1.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "mongodb": "^7.5.0",
    "mongoose": "^9.10.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "redis": "^6.2.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "@commitlint/prompt-cli": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "commitizen": "^4.3.2",
    "commitlint-plugin-tense": "^1.0.10",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/inspector": "^2.6.0",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0"
  }
}
